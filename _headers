# Cloudflare Workers static assets: response headers.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Photos, icons and other assets: a month, then revalidate in the background.
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Fonts never change under the same name. "! Cache-Control" drops the
# /assets/* value so the two rules do not get joined into one header.
/assets/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Next build output: content-hashed file names.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The shared stylesheet and script: every page links them with a ?v= content
# hash, so a change always arrives under a new URL.
/style.css
  Cache-Control: public, max-age=31536000, immutable

/assets/theme.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
